---
import Section from "./Section.astro";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import type { Content } from "@/i18n";
import { skillChips } from "@/i18n/shared";

interface Props {
  t: Content;
}
const { t } = Astro.props;
const s = t.skills;
---

<Section id="skills" eyebrow={s.eyebrow} title={s.title}>
  <ul class="grid gap-4 sm:grid-cols-2">
    {Object.entries(skillChips).map(([id, g]) => (
      <li data-reveal>
        <Card className="lift spotlight relative h-full gap-4 py-5">
          <CardHeader className="flex-row items-center gap-3 px-5">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-brand-soft text-lg" aria-hidden="true">{g.icon}</span>
            <CardTitle>{s.groups[id as keyof typeof s.groups]}</CardTitle>
          </CardHeader>
          <CardContent className="px-5">
            <ul class="flex flex-wrap gap-1.5">
              {g.skills.map((x) => (
                <li><Badge variant="outline" className="font-mono font-normal">{x.name}</Badge></li>
              ))}
            </ul>
          </CardContent>
        </Card>
      </li>
    ))}
  </ul>
</Section>
